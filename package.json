{
    "name": "@frontfactory/vitepress-theme",
    "version": "1.7.0",
    "description": "Editorial VitePress theme — hairline rules, numbered sections and monospaced metadata.",
    "type": "module",
    "scripts": {
        "build": "npm run build:css && npm run build:types",
        "build:css": "sass --style=compressed --no-source-map --pkg-importer=node --load-path=node_modules src/styles/index.scss dist/style.css",
        "dev": "npm run build:css -- --watch",
        "dev:playground": "npm run build:css && vitepress dev playground",
        "build:playground": "npm run build:css && vitepress build playground",
        "build:types": "vue-tsc -p tsconfig.build.json",
        "typecheck": "vue-tsc --noEmit",
        "lint:js": "eslint .",
        "lint:css": "stylelint \"src/**/*.scss\"",
        "lint": "npm run lint:js && npm run lint:css",
        "prepare": "husky",
        "prepack": "npm run build",
        "release": "semantic-release"
    },
    "engines": {
        "node": ">=24"
    },
    "types": "./types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./src/index.ts"
        },
        "./config": {
            "types": "./config.d.ts",
            "default": "./config.js"
        },
        "./style.css": "./dist/style.css",
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@front-factory/eslint-config": "^3.0.0",
        "@front-factory/stylelint-config": "^2.0.0",
        "@magnesium/theme": "^5.3.0",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/git": "^11.0.1",
        "conventional-changelog-conventionalcommits": "^10.4.1",
        "eslint": "^10.14.0",
        "eslint-plugin-vue": "^10.12.0",
        "husky": "^9.1.7",
        "sass": "^1.107.1",
        "semantic-release": "^25.0.9",
        "stylelint": "^17.16.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitepress": "^2.0.0-alpha.21",
        "vue": "^3.5.44",
        "vue-tsc": "^3.3.14"
    },
    "peerDependencies": {
        "vite": ">=5",
        "vitepress": "^2.0.0-alpha.20",
        "vue": "^3.5.0"
    },
    "keywords": [
        "vitepress",
        "vitepress-theme",
        "theme",
        "documentation",
        "editorial"
    ],
    "license": "MIT",
    "homepage": "https://github.com/front-factory/vitepress-theme",
    "bugs": {
        "url": "https://github.com/front-factory/vitepress-theme/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/front-factory/vitepress-theme.git"
    },
    "author": "Front Factory",
    "sideEffects": [
        "*.css"
    ],
    "files": [
        "src",
        "dist/style.css",
        "types",
        "CHANGELOG.md",
        "config.js",
        "config.d.ts"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
