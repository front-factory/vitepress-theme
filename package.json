{
    "name": "@frontfactory/vitepress-theme",
    "version": "1.5.0",
    "description": "Editorial VitePress theme — hairline rules, numbered sections and monospaced metadata.",
    "type": "module",
    "scripts": {
        "build": "sass --style=compressed --no-source-map --pkg-importer=node --load-path=node_modules src/styles/index.scss dist/style.css",
        "dev": "npm run build -- --watch",
        "dev:playground": "npm run build && vitepress dev playground",
        "build:playground": "npm run build && vitepress build playground",
        "typecheck": "vue-tsc --noEmit",
        "lint:js": "eslint .",
        "lint:css": "stylelint \"src/**/*.scss\"",
        "lint": "npm run lint:js && npm run lint:css",
        "prepare": "husky",
        "prepack": "npm run build",
        "release": "semantic-release"
    },
    "engines": {
        "node": ">=24"
    },
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./config": {
            "types": "./config.d.ts",
            "default": "./config.js"
        },
        "./style.css": "./dist/style.css",
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@front-factory/eslint-config": "^2.4.2",
        "@front-factory/stylelint-config": "^1.12.1",
        "@magnesium/theme": "^5.2.2",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.9",
        "conventional-changelog-conventionalcommits": "^9.3.1",
        "eslint": "^10.10.0",
        "eslint-plugin-vue": "^10.11.0",
        "husky": "^9.1.7",
        "sass": "^1.100.0",
        "semantic-release": "^25.0.9",
        "stylelint": "^16.26.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0",
        "vitepress": "^2.0.0-alpha.20",
        "vue": "^3.5.34",
        "vue-tsc": "^3.2.0"
    },
    "peerDependencies": {
        "vitepress": "^2.0.0-alpha.20",
        "vue": "^3.5.0"
    },
    "keywords": [
        "vitepress",
        "vitepress-theme",
        "theme",
        "documentation",
        "editorial"
    ],
    "license": "MIT",
    "homepage": "https://github.com/front-factory/vitepress-theme",
    "bugs": {
        "url": "https://github.com/front-factory/vitepress-theme/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/front-factory/vitepress-theme.git"
    },
    "author": "Front Factory",
    "sideEffects": [
        "*.css"
    ],
    "files": [
        "src",
        "dist",
        "config.js",
        "config.d.ts"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
